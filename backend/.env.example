MONGO_URI=mongodb://localhost:27017/QMetric
ACCESS_TOKEN_SECRET=your_jwt_secret_key
PORT=80

# Frontend URL(s) allowed for CORS (comma-separated if multiple, e.g. http://localhost:3000,https://q-metric-ten.vercel.app)
CLIENT_URL=http://localhost:3000,https://q-metric-ten.vercel.app

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_REDIRECT_URI=http://localhost:5555/oauth2callback
